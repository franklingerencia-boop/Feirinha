# SR - Feirinhas - variáveis de ambiente
# Copie para .env.local e preencha. Nunca versione o .env.local.

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PUBLICÁVEL (sb_publishable_...). É segura no navegador porque o banco
# usa Row Level Security. NUNCA coloque a service_role/secret key aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do app (usada em links compartilhados e e-mails de confirmação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
